data/

# ---- 依赖与构建产物 ----
node_modules/
*.log

# ---- 个人配置（含飞书表格链接、lark-cli 路径等）----
config.json

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp
